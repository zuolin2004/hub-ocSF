"""
GRPO 强化学习提升大模型数学解题能力
数据集: GSM8K
使用 trl.GRPOTrainer，可直接提交运行
"""
import re
import torch
from datasets import load_dataset
from transformers import (
    AutoModelForCausalLM,
    AutoTokenizer,
    TrainingArguments,
)
from trl import GRPOTrainer

# ===================== 配置区 =====================
MODEL_NAME = "Qwen/Qwen2‑7B‑Instruct"  # 替换为你的SFT模型路径
MAX_PROMPT_LEN = 256
MAX_RESPONSE_LEN = 512
NUM_RESPONSES = 8  # GRPO group size
KL_COEFF = 0.04
LR = 5e-6
BATCH_SIZE = 2
GRAD_ACC = 4
OUTPUT_DIR = "./grpo‑math‑output"
# ==================================================


def extract_boxed_answer(text: str):
    """提取 \boxed{} 中的数学答案，用于reward计算"""
    match = re.search(r"\\boxed\{(.*?)\}", text)
    if match:
        return match.group(1).strip()
    return None


def reward_func(samples, prompts, outputs, **kwargs):
    """数学任务奖励函数：格式 + 最终答案正确性"""
    rewards = []
    for resp, gt in zip(outputs, samples["answer"]):
        r = 0.0
        # 格式奖励：必须有boxed
        if "\\boxed{" in resp:
            r += 0.2
        pred = extract_boxed_answer(resp)
        # 答案匹配奖励
        if pred is not None and pred == gt:
            r += 0.8
        else:
            r -= 0.4
        # 简单防reward‑hacking：输出过短扣分
        if len(resp) < 80:
            r -= 0.3
        rewards.append(r)
    return rewards


def build_prompt(sample):
    """构造prompt，遵循Qwen对话格式"""
    question = sample["question"]
    messages = [
        {"role": "system", "content": "请一步步思考，解下面的数学题，最终答案放在\\boxed{}中。"},
        {"role": "user", "content": question},
    ]
    return tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)


if __name__ == "__main__":
    # 加载数据集 GSM8K
    ds = load_dataset("gsm8k", "main", split="train")

    # 加载模型与tokenizer
    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)
    model = AutoModelForCausalLM.from_pretrained(
        MODEL_NAME,
        torch_dtype=torch.bfloat16,
        device_map="auto",
        trust_remote_code=True
    )

    # 预处理数据集：构造prompt，保存ground‑truth answer
    def map_fn(ex):
        prompt_text = build_prompt(ex)
        ans_raw = ex["answer"]
        # gsm8k原始答案最后以 #### 数字结尾
        gt_ans = ans_raw.split("####")[-1].strip()
        return {"prompt": prompt_text, "answer": gt_ans}

    train_ds = ds.map(map_fn, remove_columns=ds.column_names)

    training_args = TrainingArguments(
        output_dir=OUTPUT_DIR,
        per_device_train_batch_size=BATCH_SIZE,
        gradient_accumulation_steps=GRAD_ACC,
        learning_rate=LR,
        bf16=True,
        logging_steps=10,
        save_steps=100,
        num_train_epochs=1,
        report_to="none",
        remove_unused_columns=False,
    )

    trainer = GRPOTrainer(
        model=model,
        args=training_args,
        reward_funcs=reward_func,
        train_dataset=train_ds,
        tokenizer=tokenizer,
        num_responses=NUM_RESPONSES,
        kl_coeff=KL_COEFF,
        max_prompt_length=MAX_PROMPT_LEN,
        max_completion_length=MAX_RESPONSE_LEN,
    )

    trainer.train()
    trainer.save_model(f"{OUTPUT_DIR}/final_grpo_model")
    tokenizer.save_pretrained(f"{OUTPUT_DIR}/final_grpo_model")
